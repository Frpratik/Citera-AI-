ENVIRONMENT=dev
# true = the web app also runs the background worker (fine for development).
# In production set false and run separate workers:  python -m app.worker
EMBEDDED_WORKER=true
# Required when ENVIRONMENT is not "dev". Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
LOG_LEVEL=INFO
# "text" is easy to read; use "json" in production so log tools can search the fields.
LOG_FORMAT=text
# Prometheus metrics at /metrics. Set a token to require "Authorization: Bearer <token>".
METRICS_ENABLED=true
METRICS_TOKEN=
# If the main model fails (outage, rate limit, retired), this one is tried. Empty = none.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional: prices per million tokens from your provider's price page, to estimate cost.
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
DATABASE_URL=postgresql://citera:citera@localhost:5432/citera
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
