# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Check current model names at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: a smaller/faster model just for classifying questions (empty = use GROQ_MODEL)
GROQ_CLASSIFIER_MODEL=

# Embedding model (downloaded from Hugging Face on first use, ~90 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval (scores are cosine similarity, -1..1)
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.25
STRONG_RELEVANCE_SCORE=0.45

# Limits
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=500
MAX_DOCUMENTS_PER_USER=20
RATE_LIMIT_PER_MINUTE=30

# Server
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
